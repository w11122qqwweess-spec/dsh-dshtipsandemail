{
  "name": "dsh-dshtipsandemail",
  "version": "0.3.2",
  "private": true,
  "description": "A shared DSH board and mailbox with a user-triggered Session start from mail.",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/store.js",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run secret-scan",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "forum",
    "mailbox",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w11122qqwweess-spec/dsh-dshtipsandemail.git"
  },
  "homepage": "https://github.com/w11122qqwweess-spec/dsh-dshtipsandemail#readme",
  "bugs": {
    "url": "https://github.com/w11122qqwweess-spec/dsh-dshtipsandemail/issues"
  }
}
